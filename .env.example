# ─────────────────────────────────────────────────────────────
#  Required
# ─────────────────────────────────────────────────────────────

# Postgres. Free tier: https://neon.com — or add Neon from the Vercel
# dashboard (Storage → Neon), which sets both of these for you.
#
# DATABASE_URL  = the pooled string (host ends in `-pooler`) — what the app runs
#                 on. Built for serverless: many short connections.
# DIRECT_URL    = the unpooled string — only used by `db:push`, because schema
#                 changes need the locks a pooler won't hold.
#
# Any other Postgres works too (Supabase, Railway, a server of your own): set
# DATABASE_URL, and DIRECT_URL only if that provider has a separate unpooled
# endpoint.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Any random 32+ char string:  openssl rand -base64 32
AUTH_SECRET=""

# The one account that runs the place.
HOST_EMAIL="nowlow77@gmail.com"

# ─────────────────────────────────────────────────────────────
#  Sign-in — at least one provider (both are free)
# ─────────────────────────────────────────────────────────────

# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URIs:
#   https://YOUR-DOMAIN/api/auth/callback/google
#   https://YOUR-DOMAIN/api/google/callback        ← calendar connection
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# github.com/settings/developers → New OAuth App
# Callback URL: https://YOUR-DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
#  Email — resend.com, 3 000 messages/month free
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Until you verify a domain, Resend only delivers to your own account address
# and this sender must stay as-is:
EMAIL_FROM="Fog & Company <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
#  Optional
# ─────────────────────────────────────────────────────────────

# Set this on Vercel so links in emails point at your real domain.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

APP_NAME="Fog & Company"
APP_CITY="San Francisco"
APP_TIMEZONE="America/Los_Angeles"

# House rules.
MAX_COMPANIONS="2"          # extra people a guest may bring
MAX_NIGHTS="30"             # longest stay bookable without asking you directly
BOOKING_HORIZON_DAYS="400"

# Only needed if you'd rather paste a refresh token than click
# "Connect Google Calendar" in the app's settings page.
GOOGLE_CALENDAR_REFRESH_TOKEN=""
